# Get all users
GET /users HTTP/1.1
Host: localhost:8080

###

# Get user by id
@idAdd = 1
GET /users/{{idAdd}} HTTP/1.1
Host: localhost:8080

###

# Create user
POST /users HTTP/1.1
Host: localhost:8080
Content-Type: application/x-www-form-urlencoded

username=itsna&email=itsna@mail.com&password=12345678

###

# Edit user by id
@idEdit = 1
PATCH /users/{{idEdit}} HTTP/1.1
Host: localhost:8080
Content-Type: application/x-www-form-urlencoded

username=itsna2&email=itsna@mail.com

###

# Delete user by id
@id = 1
DELETE  /users/{{id}} HTTP/1.1
Host: localhost:8080

###

# Register
POST /auth/register HTTP/1.1
Host: localhost:8080
Content-Type: application/x-www-form-urlencoded

username=Budiman&email=budiman@mail.com&password=12345678

###

# Login
POST /auth/login HTTP/1.1
Host: localhost:8080
Content-Type: application/x-www-form-urlencoded

email=budiman@mail.com&password=03062003

###

# Forgot password
@idForgot = 1
PATCH /auth/forgot-password/{{idForgot}} HTTP/1.1
Host: localhost:8080
Content-Type: application/x-www-form-urlencoded

newPassword=03062003

###

@idPhoto = 1
PATCH http://localhost:8080/users/{{idPhoto}}/upload-profile HTTP/1.1
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

------WebKitFormBoundary
Content-Disposition: form-data; name="file"; filename="test.jpeg"
Content-Type: image/jpeg

< C:/Users/ItsnaMaulana/Downloads/test.jpeg
------WebKitFormBoundary--